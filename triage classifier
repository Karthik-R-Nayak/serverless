def run_complete_pipeline(
    dump_file: str,
    case_id: str,
    s3_client=None,
    bucket: str = 'forensic-evidence',
    use_moto: bool = True
):
    """
    Run the complete pipeline:
    1. Extract triaged evidence
    2. Stream in chunks
    3. Upload to S3
    4. Generate manifest and Merkle root
    """

    print("\n" + "=" * 80)
    print("FORENSIC EVIDENCE PIPELINE — COMPLETE")
    print("=" * 80)

    # If no S3 client provided, use moto for testing
    if s3_client is None:
        if use_moto:
            from moto import mock_aws
            mock = mock_aws()
            mock.start()
            import boto3
            s3_client = boto3.client('s3', region_name='us-east-1')
            s3_client.create_bucket(Bucket=bucket)
            print("\n[INIT] Using moto for local S3 testing")
        else:
            raise ValueError("Must provide s3_client or use moto_mode=True")

    # Step 1: Initialize triage extractor
    print(f"\n[INIT] Loading dump file: {dump_file}")
    extractor = TriageStreamingExtractor(dump_file, threshold=ENTROPY_THRESHOLD)

    # Step 2: Initialize chunk uploader
    print(f"[INIT] Initializing chunk streaming uploader")
    uploader = ChunkStreamingUploader(case_id=case_id)

    # Step 3: Stream, chunk, and upload
    results = uploader.stream_and_upload(
        extractor=extractor,
        s3_client=s3_client,
        bucket=bucket,
        key=f'{case_id}/evidence.bin',
        moto_mode=use_moto
    )

    # Step 4: Save manifest
    manifest_file = f"{case_id}_manifest.json"
    with open(manifest_file, "w") as f:
        json.dump(results, f, indent=2)
    print(f"\n[SAVE] Manifest saved to: {manifest_file}")

    return results


