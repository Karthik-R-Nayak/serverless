@dataclass
class ChunkMetadata:
    """Metadata for a single chunk"""
    chunk_id: int
    offset: int
    size: int
    sha256: str
    timestamp: float
    case_id: str


@dataclass
class ManifestEntry:
    """Single manifest entry (combines triage + chunking)"""
    page_number: int
    entropy: float
    sha256: str  # page hash from triage
    chunk_id: int  # which chunk contains this page
    chunk_offset: int  # offset within chunk


class TriageStreamingExtractor:
    """
    Reads dump file, applies triage classifier, and yields pages.
    This is a generator that works with streaming pipeline.
    """

    def __init__(self, filename: str, threshold: float = ENTROPY_THRESHOLD):
        self.filename = filename
        self.threshold = threshold
        self.page_number = 0
        self.kept = 0
        self.dropped = 0

    def extract(self):
        """
        Generator that yields (page_bytes, metadata) for pages to keep.
        Applies triage classification on-the-fly.
        """
        with open(self.filename, "rb") as f:
            while True:
                page = f.read(PAGE_SIZE)
                if not page:
                    break

                keep, entropy = classify_page(page, self.threshold)

                if keep:
                    page_hash = sha256_page(page)
                    metadata = {
                        'page_number': self.page_number,
                        'entropy': round(entropy, 4),
                        'sha256': page_hash.hex(),
                        'page_bytes': len(page)
                    }
                    self.kept += 1
                    yield page, metadata
                else:
                    self.dropped += 1

                self.page_number += 1

    def stats(self):
        """Return processing statistics"""
        return {
            'total_pages': self.page_number,
            'kept_pages': self.kept,
            'dropped_pages': self.dropped,
            'drop_rate_pct': (self.dropped / self.page_number * 100) if self.page_number > 0 else 0
        }


class ChunkStreamingUploader:
    """
    Streams triaged evidence in 64MB chunks to S3 with pipelined hashing.
    
    Key features:
    - Reads triaged evidence from extractor
    - Buffers into 64MB chunks
    - Hashes each chunk during read (zero overhead)
    - Uploads chunks in parallel (8 threads)
    - Generates manifest and Merkle root
    - Provides error recovery per-chunk
    """

    def __init__(
        self,
        case_id: str,
        chunk_size: int = CHUNK_SIZE,
        max_workers: int = MAX_WORKERS
    ):
        self.case_id = case_id
        self.chunk_size = chunk_size
        self.max_workers = max_workers

        self.chunk_id = 0
        self.chunks_uploaded = 0
        self.chunks_failed = 0
        self.chunk_hashes = []
        self.manifest = []
        self.lock = threading.Lock()

    def stream_and_upload(
        self,
        extractor: TriageStreamingExtractor,
        s3_client,
        bucket: str,
        key: str,
        moto_mode: bool = True  # Use moto for local testing
    ) -> Dict:
        """
        Stream triaged pages from extractor, chunk them, and upload to S3.

        Args:
            extractor: TriageStreamingExtractor instance
            s3_client: boto3 S3 client (real or moto)
            bucket: S3 bucket name
            key: S3 object key
            moto_mode: if True, compatible with moto (local testing)

        Returns:
            Dict with upload results and statistics
        """
        print("\n" + "=" * 80)
        print("CHUNK STREAMING UPLOAD")
        print("=" * 80)

        start_time = time.perf_counter()
        current_chunk = bytearray()
        current_chunk_id = 0
        chunk_pages = []  # Track which pages are in this chunk
        full_hash = hashlib.sha256()
        all_page_hashes = []

        # Initiate multipart upload
        print(f"\n[STREAM] Initiating multipart upload to s3://{bucket}/{key}")
        mpu = s3_client.create_multipart_upload(
            Bucket=bucket,
            Key=key,
            Metadata={
                'case-id': self.case_id,
                'method': 'chunk-streaming',
                'triage-mode': 'entropy-filtered'
            }
        )
        upload_id = mpu['UploadId']
        parts = []

        # Extract and chunk
        print(f"[STREAM] Streaming triaged evidence in {self.chunk_size / (1024**2):.0f}MB chunks")
        print()

        with ThreadPoolExecutor(max_workers=self.max_workers) as executor:
            futures = {}

            for page, page_metadata in extractor.extract():
                # Add page to chunk
                current_chunk.extend(page)
                all_page_hashes.append(bytes.fromhex(page_metadata['sha256']))
                chunk_pages.append(page_metadata)

                # Update running hash
                full_hash.update(page)

                # Check if chunk is full
                if len(current_chunk) >= self.chunk_size:
                    chunk_data = bytes(current_chunk)
                    chunk_hash = hashlib.sha256(chunk_data).hexdigest()
                    self.chunk_hashes.append(chunk_hash)

                    # Submit upload (non-blocking)
                    fut = executor.submit(
                        self._upload_chunk,
                        s3_client, bucket, key, upload_id,
                        current_chunk_id + 1,  # PartNumber is 1-indexed
                        chunk_data,
                        chunk_hash,
                        len(chunk_pages)
                    )

                    futures[fut] = (current_chunk_id, chunk_hash, chunk_pages)

                    # Reset for next chunk
                    current_chunk = bytearray()
                    chunk_pages = []
                    current_chunk_id += 1

            # Handle final partial chunk
            if len(current_chunk) > 0:
                chunk_data = bytes(current_chunk)
                chunk_hash = hashlib.sha256(chunk_data).hexdigest()
                self.chunk_hashes.append(chunk_hash)

                fut = executor.submit(
                    self._upload_chunk,
                    s3_client, bucket, key, upload_id,
                    current_chunk_id + 1,
                    chunk_data,
                    chunk_hash,
                    len(chunk_pages)
                )
                futures[fut] = (current_chunk_id, chunk_hash, chunk_pages)

            # Wait for all uploads to complete
            print(f"[STREAM] Uploading {len(futures)} chunks in parallel...")
            for fut in as_completed(futures):
                try:
                    chunk_id, etag = fut.result()
                    parts.append({
                        'PartNumber': chunk_id,
                        'ETag': etag
                    })
                    self.chunks_uploaded += 1
                except Exception as e:
                    self.chunks_failed += 1
                    print(f"[STREAM] ✗ Chunk upload failed: {e}")

        # Complete multipart upload
        if self.chunks_uploaded > 0:
            print(f"\n[STREAM] Completing multipart upload ({self.chunks_uploaded} chunks)")
            s3_client.complete_multipart_upload(
                Bucket=bucket,
                Key=key,
                UploadId=upload_id,
                MultipartUpload={'Parts': sorted(parts, key=lambda x: x['PartNumber'])}
            )

        # Generate Merkle root
        merkle_root = build_merkle_root(
            [bytes.fromhex(h) for h in self.chunk_hashes]
        )

        elapsed = time.perf_counter() - start_time

        # Build results
        results = {
            'case_id': self.case_id,
            'chunks_total': current_chunk_id + 1,
            'chunks_uploaded': self.chunks_uploaded,
            'chunks_failed': self.chunks_failed,
            'manifest': self.manifest,
            'merkle_root': merkle_root,
            'full_hash': full_hash.hexdigest(),
            'chunk_hashes': self.chunk_hashes,
            'total_time': elapsed,
            'triage_stats': extractor.stats(),
        }

        # Print results
        self._print_results(results)

        return results

    def _upload_chunk(
        self,
        s3_client,
        bucket: str,
        key: str,
        upload_id: str,
        part_number: int,
        chunk_data: bytes,
        chunk_hash: str,
        num_pages: int
    ) -> Tuple[int, str]:
        """
        Upload a single chunk to S3.
        Returns (part_number, etag) on success.
        """
        try:
            response = s3_client.upload_part(
                Bucket=bucket,
                Key=key,
                UploadId=upload_id,
                PartNumber=part_number,
                Body=chunk_data
            )

            chunk_mb = len(chunk_data) / (1024 ** 2)
            print(f"[STREAM] ✓ Chunk {part_number:3d}: {chunk_mb:6.1f} MB | Hash: {chunk_hash[:16]}... | Pages: {num_pages}")

            # Extract ETag (remove quotes if present)
            etag = response['ETag'].strip('"')
            return part_number, etag

        except Exception as e:
            print(f"[STREAM] ✗ Chunk {part_number} failed: {e}")
            raise

    def _print_results(self, results: Dict):
        """Print formatted results"""
        print("\n" + "=" * 80)
        print("STREAMING UPLOAD COMPLETE")
        print("=" * 80)

        print(f"\nCase ID: {results['case_id']}")
        print(f"\nChunks:")
        print(f"  Total:    {results['chunks_total']}")
        print(f"  Uploaded: {results['chunks_uploaded']}")
        print(f"  Failed:   {results['chunks_failed']}")

        print(f"\nTriage Statistics:")
        triage = results['triage_stats']
        print(f"  Total pages:  {triage['total_pages']:,}")
        print(f"  Kept:         {triage['kept_pages']:,}")
        print(f"  Dropped:      {triage['dropped_pages']:,}")
        print(f"  Drop rate:    {triage['drop_rate_pct']:.2f}%")

        print(f"\nIntegrity:")
        print(f"  Full hash:    {results['full_hash']}")
        print(f"  Merkle root:  {results['merkle_root']}")

        print(f"\nTiming:")
        print(f"  Total time:   {results['total_time']:.2f}s")
        print(f"  Throughput:   {self._calculate_throughput(results):.1f} MB/s")

        print("\n" + "=" * 80)

    def _calculate_throughput(self, results: Dict) -> float:
        """Calculate upload throughput in MB/s"""
        total_mb = len(results['chunk_hashes']) * (self.chunk_size / (1024 ** 2))
        total_seconds = results['total_time']
        return total_mb / total_seconds if total_seconds > 0 else 0


