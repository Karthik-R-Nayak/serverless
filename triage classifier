"""
CHUNK STREAMING MECHANISM FOR FORENSIC EVIDENCE PIPELINE

Integrates with your triage classifier to:
1. Read triaged evidence in 64MB chunks
2. Pipeline hashing during reads (zero overhead)
3. Upload chunks to S3 with 8 parallel threads
4. Generate Merkle tree covering entire sequence
5. Provide complete error recovery and verification
"""

import numpy as np
import hashlib
import json
import time
import struct
import threading
from pathlib import Path
from concurrent.futures import ThreadPoolExecutor, as_completed
from typing import List, Tuple, Dict, Optional
from dataclasses import dataclass, asdict


# ============================================================================
# CONSTANTS
# ============================================================================

PAGE_SIZE = 4096
ENTROPY_THRESHOLD = 1.0
CHUNK_SIZE = 64 * 1024 * 1024  # 64 MB chunks
MAX_WORKERS = 8  # parallel upload threads


# ============================================================================
# TRIAGE CLASSIFIER (from your code)
# ============================================================================

def calculate_entropy(page):
    """Calculate Shannon entropy of a page"""
    arr = np.frombuffer(page, dtype=np.uint8)
    counts = np.bincount(arr, minlength=256)
    probs = counts[counts > 0] / arr.size
    return float(-np.sum(probs * np.log2(probs)))


def classify_page(page, threshold=ENTROPY_THRESHOLD):
    """Classify a page: keep or skip"""
    arr = np.frombuffer(page, dtype=np.uint8)

    # Zero-page detection
    if not arr.any():
        return False, 0.0

    entropy = calculate_entropy(page)

    if entropy < threshold:
        return False, entropy

    return True, entropy


def sha256_page(page):
    """Compute SHA-256 hash of a page"""
    return hashlib.sha256(page).digest()


def build_merkle_root(hashes):
    """Build Merkle tree and return root hash"""
    if not hashes:
        return None

    current = hashes[:]

    while len(current) > 1:
        if len(current) % 2:
            current.append(current[-1])

        next_level = []
        for i in range(0, len(current), 2):
            combined = current[i] + current[i + 1]
            next_hash = hashlib.sha256(combined).digest()
            next_level.append(next_hash)

        current = next_level

    return current[0].hex()


